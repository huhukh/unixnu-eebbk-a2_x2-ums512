+/*
+ * Non-Apple platform sleep hook. ArmCpu installs it when boot-arg
+ * platform-sleep=1, and a static kernel link requires every weak_import
+ * to resolve. ml_arm_sleep in xnu-8796 has no call site for it, so sleep
+ * stays disabled unless a board adds the call and its wake path.
+ */
+void (*arm64_platform_sleep_hook)(boolean_t boot_cpu) = NULL;
