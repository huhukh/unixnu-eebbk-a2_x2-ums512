
# Realme C21Y RMX3261 (Unisoc T610 / UMS512)
# Experimental first-bring-up kernel configuration.
#
# Based on the UniXNU ARM device-tree platform configuration.
# Storage, display, GPU and trust-cache paths remain disabled until
# their C21Y-specific implementations are verified on hardware.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_NATIVE_TRUST_CACHE=0
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
