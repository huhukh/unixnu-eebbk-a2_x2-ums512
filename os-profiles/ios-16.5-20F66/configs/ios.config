# iOS 16.5 kernel configuration, applied after the SoC fragment and before the device defconfig.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# xnu-8796's BCM2837.h defines PLATFORM_PANIC_LOG_PADDR 0x3c0fc000 (the Raspberry Pi 3 panic buffer), so
# check_for_panic_log() in PE_create_console() reads and clears 16 KiB there. On SM8250 that is not DRAM and the
# boot hangs before the video console (apollo, 2026-11-13: entry-probe resets after kernel_startup_initialize_upto
# but not after PE_create_console). Take the panic region from the ADT instead (native-dt-panic-region.patch).
CONFIG_XNU_DT_PANIC_REGION=y
