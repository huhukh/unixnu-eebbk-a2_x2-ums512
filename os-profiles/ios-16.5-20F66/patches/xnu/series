# iOS 16.5 (xnu-8796.121.2) kernel patches, in application order.
#
# The board selects this series instead of arch:patches/xnu/series (written for xnu-10063).
# SOC profile already applies arch:patches/xnu/series; this series only adds xnu-8796 ports and XnuPrelink components.

../xnu-8796/apple-only-cpu-tunables.patch
# Linux build #146 R32: link failed on _ml_enable_monitor (arm_vm_init.c) and
# _CleanPoC_DcacheRegion_Force_nopreempt_nohid (pmap.c). Neither has a definition
# in the OSS tree; UniXNU's non-apple-cache-monitor patch guards the monitor call
# and aliases the cache clean symbol for non-Apple targets. Port both hunks.
../xnu-8796/8796-non-apple-cache-monitor.patch
# xnu-8796 pmap.c includes arm64/ppl/sart.h and uat.h unconditionally and calls
# sart_bootstrap()/uat_bootstrap(). Those Apple PPL headers are absent from the
# pinned source and BCM2837 defines no XNU_MONITOR_ANS2_SART/UAT_PPL. This
# 8796 port of UniXNU's non-apple-iommu-bootstrap patch guards all four sites,
# exactly as the arch (xnu-10063) series does. Evidence: build #143 R21.
../xnu-8796/8796-non-apple-iommu-bootstrap.patch
# macOS bootstrap (build #2 R23): make_symbol_aliasing.sh looks for
# availability.pl inside the Xcode SDK, where Xcode 26.6 does not ship it.
# build-xnu-4k-baseline.sh builds it from the pinned AvailabilityVersions feed
# into .cache/fakeroot and exports XNU_AVAILABILITY_PL; this 8796 port of
# UniXNU's arch patch makes the script honour that variable.
../xnu-8796/local-availability.patch
# macOS build #3 R24: libfirehose_kernel installs its private header at
# .cache/fakeroot/usr/local/include/kernel/os/, but xnu-8796 MakeInc.def only
# adds -I$(SDKROOT)/usr/local/include/kernel. Port UniXNU's kernel-sdk-root
# patch so KERNEL_SDKROOT (the fakeroot DSTROOT) drives both -I and -L paths.
../xnu-8796/kernel-sdk-root.patch
../xnu-8796/external-archive-dependencies.patch
../xnu-8796/native-aes-personality.patch
../xnu-8796/source-machine-layer.patch
../xnu-8796/zzx-pmap-sync-64bit-pa.patch

# Newer clang (UniXNU's toolchain) removed the flag that acknowledged -ftrivial-auto-var-init=zero; xnu-8796 still passes it.
../xnu-8796/clang-drop-auto-var-init-acknowledgement.patch
# Newer clang rejects arrays of the over-aligned uio_stackbuf_t; backport later xnu's UIO_STACKBUF().
../xnu-8796/clang-uio-stackbuf.patch
# The toolchain's iig generates DriverKit glue that reads IORPC.kernelContent (later xnu); backport the field.
../xnu-8796/iorpc-kernel-content.patch
# Current clang rejects __typeof__(*(void *)) in C++; backport xnu-10063's os_get_pointee_type() for kalloc type checks.
../xnu-8796/kalloc-pointee-type.patch
# macOS run #12 R35: mockfs fixture failed __builtin_xnu_types_compatible on
# kalloc_type/kfree_type(mockfs_fsnode_t, ...). The arch (xnu-10063) series carries
# UniXNU's typed-allocation correction but this board applies soc/os/device only.
# Same upstream patch applies byte-for-byte to the pinned 8796 source.
../xnu-8796/8796-mockfs-typed-allocation.patch
# The xnu-8796 source release omits osfmk/arm64/kpc.c; xnu-10063's file, whose non-Apple branch stubs the PMU backend.
../xnu-8796/arm64-kpc-from-xnu-10063.patch
# UniXNU's archive builders read per-object compile records (clang -MJ), which xnu-10063's MakeInc.rule writes.
../xnu-8796/compile-records.patch
# UniXNU's libpthread (519.120.4) calls proc_get_jit_entitled; backport that pthread callback from xnu-10063.
../xnu-8796/pthread-jit-entitled-callback.patch
# Build #148 R36: build-libpthread-kernel.py compiles bsd/kern/source_pthread_bootstrap.c,
# a new file supplied by UniXNU's arch arm64 series. This board's soc→os→device series
# excludes arch, so the file is absent: clang-24 "no such file or directory". Add the
# upstream new-file patch verbatim after the callback patch.
../xnu-8796/8796-source-pthread-bootstrap.patch

